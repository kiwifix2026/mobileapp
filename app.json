{
  "expo": {
    "name": "KiwiFix",
    "slug": "mobileapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nz.kiwifix.app"
    },
    "android": {
      "package": "nz.kiwifix.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "510a5477-cc24-4aa0-af30-2e731d486305"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "KiwiFix needs access to your photos so you can attach pictures to jobs and your profile."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
